{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "shell",
            "command": "./.claude/hooks/macos_notify.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "shell",
            "command": "./.claude/hooks/macos_notify.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Purr.aiff"
          }
        ]
      }
    ]
  }
}
