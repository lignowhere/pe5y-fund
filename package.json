{
  "name": "pe5y-fund",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"uvicorn backend.main:app --host 127.0.0.1 --port 8002 --reload --reload-dir backend\" \"cd frontend && npm run dev\"",
    "backend": "uvicorn backend.main:app --host 127.0.0.1 --port 8002 --reload --reload-dir backend",
    "frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "lint": "cd frontend && npm run lint",
    "audit": "npm audit --audit-level=high && npm --prefix frontend audit --audit-level=high"
  },
  "devDependencies": {
    "concurrently": "10.0.4"
  }
}
