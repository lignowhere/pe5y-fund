generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for JWT authentication
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  name      String   @db.VarChar(255)
  role      UserRole @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  USER

  @@map("user_role")
}

model Warehouse {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  locationCode String   @unique @map("location_code") @db.VarChar(50)
  address      String?  @db.Text
  country      String?  @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp

  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  transfersFrom      StockTransfer[]     @relation("FromWarehouse")
  transfersTo        StockTransfer[]     @relation("ToWarehouse")
  batchesLots        BatchLot[]

  @@map("warehouses")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  sku             String   @unique @db.VarChar(100)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  category        String?  @db.VarChar(100)
  costPriceUsd    Decimal  @map("cost_price_usd") @db.Decimal(19, 2)
  sellingPriceUsd Decimal  @map("selling_price_usd") @db.Decimal(19, 2)
  weightKg        Decimal? @map("weight_kg") @db.Decimal(10, 2)
  dimensions      Json?    @db.JsonB
  barcode         String?  @unique @db.VarChar(100)
  imageUrl        String?  @map("image_url") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp

  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  stockTransfers     StockTransfer[]
  batchesLots        BatchLot[]

  @@index([sku])
  @@index([barcode])
  @@index([category])
  @@index([name])
  @@map("products")
}

model Inventory {
  id                String    @id @default(uuid()) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  warehouseId       String    @map("warehouse_id") @db.Uuid
  quantityAvailable Int       @map("quantity_available") @default(0)
  quantityReserved  Int       @map("quantity_reserved") @default(0)
  quantityIncoming  Int       @map("quantity_incoming") @default(0)
  reorderPoint      Int       @map("reorder_point") @default(10)
  lastRestockedAt   DateTime? @map("last_restocked_at") @db.Timestamp
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId, quantityAvailable])
  @@map("inventory")
}

enum MovementType {
  adjustment_in
  adjustment_out
  transfer_in
  transfer_out
  initial_stock
  return
  damage
  sale

  @@map("movement_type")
}

model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  movementType   MovementType @map("movement_type")
  quantity       Int
  quantityBefore Int          @map("quantity_before")
  quantityAfter  Int          @map("quantity_after")
  referenceId    String?      @map("reference_id") @db.Uuid
  notes          String?      @db.Text
  createdBy      String?      @map("created_by") @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamp

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([productId, warehouseId])
  @@index([movementType])
  @@map("inventory_movements")
}

enum TransferStatus {
  pending
  in_transit
  completed
  cancelled

  @@map("transfer_status")
}

model StockTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  productId       String         @map("product_id") @db.Uuid
  fromWarehouseId String         @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String         @map("to_warehouse_id") @db.Uuid
  quantity        Int
  status          TransferStatus @default(pending)
  initiatedAt     DateTime       @map("initiated_at") @db.Timestamp
  completedAt     DateTime?      @map("completed_at") @db.Timestamp
  notes           String?        @db.Text
  createdBy       String?        @map("created_by") @db.VarChar(255)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

model BatchLot {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  warehouseId      String    @map("warehouse_id") @db.Uuid
  batchNumber      String    @map("batch_number") @db.VarChar(100)
  quantity         Int
  manufacturedDate DateTime? @map("manufactured_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  receivedDate     DateTime? @map("received_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([batchNumber])
  @@index([productId, warehouseId])
  @@map("batches_lots")
}
